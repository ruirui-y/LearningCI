{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LearningCI Skill Node",
  "type": "object",
  "required": [
    "id",
    "name",
    "domain",
    "priority",
    "status",
    "capability_definition",
    "scoring"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "priority": {
      "enum": [
        "CORE",
        "IMPORTANT",
        "OPTIONAL"
      ]
    },
    "status": {
      "enum": [
        "LOCKED",
        "READY",
        "ACTIVE",
        "TRAINING",
        "VERIFYING",
        "FAILED",
        "PASSED",
        "RETEST_DUE",
        "STABLE"
      ]
    },
    "estimated_hours": {
      "type": "number",
      "minimum": 0
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capability_definition": {
      "type": "string"
    },
    "must_learn": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "out_of_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "project_anchor": {
      "type": "object"
    },
    "scoring": {
      "type": "object",
      "required": [
        "explanation",
        "prediction",
        "implementation",
        "diagnosis",
        "transfer"
      ],
      "properties": {
        "explanation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "prediction": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "implementation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 25
        },
        "diagnosis": {
          "type": "integer",
          "minimum": 0,
          "maximum": 25
        },
        "transfer": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        }
      }
    },
    "retest_7d": {
      "type": [
        "string",
        "null"
      ]
    },
    "retest_30d": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
