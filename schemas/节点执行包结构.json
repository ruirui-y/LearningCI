{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LearningCI Node Bundle",
  "type": "object",
  "required": [
    "schema_version",
    "node_id",
    "task_groups",
    "task_count",
    "verification_paper",
    "retest_policy"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "node_id": {"type": "string"},
    "node_title": {"type": "string"},
    "source_plan_version": {"type": "string"},
    "source_section": {"type": "string"},
    "compiler": {"type": "object"},
    "task_policy": {"type": "object"},
    "task_groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "items"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "description": {"type": "string"},
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "title", "detail", "purpose", "estimated_minutes", "required", "done_when"],
              "properties": {
                "id": {"type": "string"},
                "title": {"type": "string"},
                "detail": {"type": "string"},
                "purpose": {"type": "string"},
                "estimated_minutes": {"type": "integer", "minimum": 1},
                "required": {"type": "boolean"},
                "evidence_required": {"type": "boolean"},
                "evidence_fields": {"type": "array", "items": {"type": "string"}},
                "done_when": {"type": "array", "minItems": 1, "items": {"type": "string"}}
              }
            }
          }
        }
      }
    },
    "task_count": {"type": "integer", "minimum": 1},
    "verification_paper": {
      "type": "object",
      "required": ["paper_id", "version", "questions"],
      "properties": {
        "paper_id": {"type": "string"},
        "version": {"type": "integer", "minimum": 1},
        "visible_from_start": {"type": "boolean"},
        "frozen": {"type": "boolean"},
        "questions": {"type": "array", "minItems": 5, "maxItems": 5}
      }
    },
    "retest_policy": {"type": "object"}
  }
}
